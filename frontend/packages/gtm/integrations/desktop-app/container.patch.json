      {
        "variableId": "800130",
        "name": "Sealos Desktop App | App scope",
        "type": "jsm",
        "parentFolderId": "800000",
        "parameter": [
          {
            "type": "template",
            "key": "javascript",
            "value": "function() {\n  return location.protocol === 'http:' && location.hostname === '127.0.0.1' &&\n    /^\\/desktop-app-analytics\\/[a-f0-9]{32}\\/index\\.html$/.test(location.pathname) &&\n    {{Sealos Desktop App | DLV - surface}} === 'desktop_app' &&\n    {{Sealos Desktop App | DLV - product_edition}} === 'global' &&\n    {{Sealos Desktop App | DLV - analytics_consent}} === 'granted';\n}"
          }
        ]
      },
      {
        "variableId": "800131",
        "name": "Sealos Desktop App | App event allowed",
        "type": "jsm",
        "parentFolderId": "800000",
        "parameter": [
          {
            "type": "template",
            "key": "javascript",
            "value": "function() {\n  return /^(?:app_launch|app_first_open|app_screen_view|login_required|login_started|login_succeeded|login_failed|task_created|task_opened|deploy_finished|visitor_linked)$/.test({{Sealos Desktop App | DLV - app_event_name}});\n}"
          }
        ]
      },
      {
        "variableId": "800132",
        "name": "Sealos Desktop App | Web link scope",
        "type": "jsm",
        "parentFolderId": "800000",
        "parameter": [
          {
            "type": "template",
            "key": "javascript",
            "value": "function() {\n  var uuid = /^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/i;\n  return location.protocol === 'https:' &&\n    /^(?:[a-z0-9-]+\\.)+sealos\\.io$/.test(location.hostname) && location.hostname !== 'www.sealos.io' &&\n    {{Sealos Desktop App | DLV - product_edition}} === 'global' &&\n    {{Sealos Desktop App | DLV - analytics_consent}} === 'granted' &&\n    uuid.test({{Sealos Desktop App | DLV - user_id}}) && uuid.test({{Sealos Desktop App | DLV - visitor_id}});\n}"
          }
        ]
      }
