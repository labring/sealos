# Reference only: neither the Go service nor entrypoint.sh loads this file.
# Export script options, or pass them with `sealos run ... --env KEY=value`.

# Helm release and namespace. Resource names follow RELEASE_NAME:
# <release>, <release>-deployment and <release>-config.
RELEASE_NAME=vlogs
RELEASE_NAMESPACE=sealos
# Relative to the deployment package working directory.
CHART_PATH=./charts/vlogs
LEGACY_MANIFEST=./remove/deploy.yaml
# Shared installer tools; must provide ensure_global_values_ready_for_component,
# global_http_scheme and global_http_effective_port. Override with a compatible file.
TOOLS_FILE=/root/.sealos/cloud/scripts/tools.sh
# Optional Helm overrides, applied after auto-config; HELM_OPTS has last priority.
# Values are split on whitespace by the release-v5.1 entrypoint.
HELM_OPTIONS=
HELM_OPTS=

# Local service only: allowed Kubernetes API URLs, comma-separated; default empty.
# During deployment the entrypoint derives this from the global HTTP configuration
# and injects it through serviceVlogsConfig.whitelistKubernetesHosts.
# Override deployment auto-config with HELM_OPTS="--set-string serviceVlogsConfig.whitelistKubernetesHosts=https://api.example.com".
WHITELIST_KUBERNETES_HOSTS=

# Operator values path is fixed, not an environment override:
# /root/.sealos/cloud/values/core/vlogs-values.yaml
# Missing file is seeded from charts/vlogs/vlogs-monitor-values.yaml.
# Backend credentials are read from sealos-system/vlogs-config-user
# (SELECT_USER and SELECT_PASSWORD); cloudDomain from sealos-system/sealos-config.
# Backend default: http://usr-vlc-victoria-logs-cluster-vmauth.vlc.svc:8427
# Use HELM_OPTIONS/HELM_OPTS to override auto-configured Helm fields.
