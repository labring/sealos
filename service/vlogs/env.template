# Documentation template; the Go service does NOT load this file automatically.
# Export this variable when running locally, or use the corresponding Helm value.
# Comma-separated allowed Kubernetes API URLs. Default: empty (no explicit hosts).
# Helm: serviceVlogsConfig.whitelistKubernetesHosts
WHITELIST_KUBERNETES_HOSTS=

# Deployment script options (export before invoking deploy/entrypoint.sh).
# Helm release name and namespace; these do not rename the stable service-vlogs resources.
RELEASE_NAME=vlogs
RELEASE_NAMESPACE=sealos
# Chart directory, relative to the deploy working directory.
CHART_PATH=./charts/vlogs
# Operator values file; missing file is created from the template and installation stops.
USER_VALUES_PATH=/root/.sealos/cloud/values/core/vlogs-values.yaml
# Optional backup directory override; default is /root/.sealos/cloud/backups/vlogs-<timestamp>.
# BACKUP_DIR=/path/to/private/vlogs-backup
# Standard kubectl/Helm cluster selection; default is the current kubeconfig context.
# KUBECONFIG=/path/to/kubeconfig
