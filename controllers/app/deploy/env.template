# Optional deployment-script environment overrides (not application variables).
# Chart directory, default: charts/app-controller alongside entrypoint.sh.
# CHART_PATH=/path/to/charts/app-controller
# Helm namespace, default: app-system.
# RELEASE_NAMESPACE=app-system
# Persisted Helm values, default shown below; edit to override image/resources/probes.
# USER_VALUES_FILE=/root/.sealos/cloud/values/core/app-controller-values.yaml
# Rollout timeout, default: 5m.
# HELM_TIMEOUT=5m
