{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "image",
    "config"
  ],
  "properties": {
    "image": {
      "type": "string",
      "minLength": 1
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "config": {
      "type": "object",
      "required": [
        "cnameDomains"
      ],
      "properties": {
        "cnameDomains": {
          "type": "string",
          "minLength": 1
        },
        "cnameAppenDomains": {
          "type": "string"
        },
        "cnameCheck": {
          "type": "boolean"
        },
        "ingressWebhookEnabled": {
          "type": "boolean"
        },
        "namespaceWebhookEnabled": {
          "type": "boolean"
        },
        "resourceCreatorWebhookEnabled": {
          "type": "boolean"
        },
        "resourceCreatorWebhookFailurePolicy": {
          "enum": [
            "Fail",
            "Ignore"
          ]
        },
        "icpEnabled": {
          "type": "boolean"
        },
        "ingressWebhookFailurePolicy": {
          "enum": [
            "Fail",
            "Ignore"
          ]
        },
        "namespaceWebhookFailurePolicy": {
          "enum": [
            "Fail",
            "Ignore"
          ]
        }
      }
    },
    "imagePullPolicy": {
      "enum": [
        "Always",
        "IfNotPresent",
        "Never"
      ]
    },
    "updateStrategy": {
      "type": "object",
      "properties": {
        "maxUnavailable": {
          "enum": [
            0
          ]
        },
        "maxSurge": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "webhook": {
      "type": "object",
      "properties": {
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        }
      }
    }
  }
}
